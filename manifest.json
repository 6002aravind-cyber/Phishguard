{
  "manifest_version": 3,
  "name": "PhishGuard — Link Authenticity Checker",
  "version": "0.1.0",
  "description": "Checks if a link really belongs to your company, or is a phishing lookalike.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}
